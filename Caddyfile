{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
